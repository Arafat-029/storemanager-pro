# Copiez ce fichier en ".env" puis remplissez le mot de passe.
# Le fichier .env ne doit JAMAIS etre versionne (il est deja dans .gitignore).
#
#   copy .env.example .env
#

# Base de donnees : "mysql" ou "sqlite"
DB_BACKEND=mysql

# Connexion MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=storemanager
MYSQL_PASSWORD=REMPLACER_PAR_VOTRE_MOT_DE_PASSE
MYSQL_DATABASE=storemanager
MYSQL_CHARSET=utf8mb4
