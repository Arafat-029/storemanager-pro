/* ══════════════════════════════════════════════════════
   StoreManager Pro — ADLSOFT-Style Colorful Dark Theme
   ══════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI", "Inter", "Ubuntu", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    outline: none;
    box-sizing: border-box;
}

QLabel {
    background: transparent;
    border: none;
    padding: 0;
    color: #CBD5E1;
}

QMainWindow, QDialog {
    background-color: #0B1121;
    color: #CBD5E1;
}

QWidget {
    color: #CBD5E1;
}

QStackedWidget > QWidget,
QScrollArea > QWidget > QWidget {
    background-color: #0B1121;
}

/* ── Top Navigation Bar ──────────────────────────────────────── */
#topNavBar {
    background-color: #060D1B;
    border-bottom: 3px solid #1E88E5;
}

#topNavBar QLabel {
    color: #FFFFFF;
    background: transparent;
    border: none;
}

#appTitle {
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    background: transparent;
    letter-spacing: 0.5px;
}

#appLogo {
    font-size: 24px;
    color: #FFFFFF;
    background: transparent;
}

QPushButton#topNavBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}
QPushButton#topNavBtn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
}
QPushButton#topNavBtn:checked {
    background: rgba(30, 136, 229, 0.3);
    color: #FFFFFF;
    border-bottom: 3px solid #1E88E5;
    font-weight: 700;
}

#clockLabel {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
    background: transparent;
}

#userInfoLabel {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
    font-weight: 600;
}

/* ── Sidebar ── */
#sidebar {
    background-color: #060D1B;
    border-right: 1px solid #1A2744;
    min-width: 230px;
    max-width: 230px;
}

#sidebarLogo { font-size: 38px; }

#sidebarTitle {
    font-size: 16px; font-weight: 700; color: #1E88E5; letter-spacing: 0.5px;
}

#sidebarVersion { font-size: 11px; color: #334155; }

QPushButton#navBtn {
    background: transparent; border: none; border-radius: 8px;
    margin: 2px 8px; text-align: left; padding: 11px 16px;
    color: #64748B; font-size: 13px; font-weight: 500;
}
QPushButton#navBtn:hover { background: rgba(30, 136, 229, 0.1); color: #CBD5E1; }
QPushButton#navBtn:checked { background: rgba(30, 136, 229, 0.2); color: #1E88E5; font-weight: 700; }

#userPanel { background: #040A16; border-top: 1px solid #1A2744; }

#userNameLabel { font-size: 13px; font-weight: 600; color: #CBD5E1; background: transparent; }
#userRoleLabel { font-size: 11px; color: #475569; background: transparent; }

QPushButton#btnLogout {
    background: rgba(239, 68, 68, 0.1); border: 1.5px solid rgba(239, 68, 68, 0.35);
    border-radius: 8px; padding: 8px 14px; color: #EF4444; font-size: 12px; font-weight: 600;
}
QPushButton#btnLogout:hover { background: rgba(239, 68, 68, 0.22); border-color: #EF4444; color: #FCA5A5; }

/* ── Top Bar (page title sub-bar) ── */
#topBar {
    background-color: #0D1525;
    border-bottom: 1px solid #1A2744;
    min-height: 50px;
    max-height: 50px;
}

#pageTitle {
    font-size: 17px; font-weight: 700; color: #E2E8F0;
    letter-spacing: 0.3px; background: transparent;
}

/* ── Dashboard Tiles ─────────────────────────────────────────── */
QPushButton#dashTile {
    border: none;
    border-radius: 12px;
    padding: 20px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    min-width: 180px;
    min-height: 140px;
    text-align: center;
}
QPushButton#dashTile:hover { opacity: 0.85; }
QPushButton#dashTile:pressed { padding-top: 22px; }

/* ── Company Info Banner ─────────────────────────────────────── */
#companyBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0D1525, stop:1 #1A2744);
    border-radius: 10px;
    padding: 16px 24px;
    border: 1px solid #1A2744;
}
#companyBanner QLabel { color: #FFFFFF; background: transparent; border: none; }

/* ── Stat Cards ── */
#statCard {
    background-color: #111B2E;
    border: 1px solid #1A2744;
    border-radius: 12px;
}
#statCard:hover { border-color: #1E88E5; background-color: #152238; }

#cardValue { font-size: 26px; font-weight: 700; background: transparent; }
#cardLabel { font-size: 12px; color: #64748B; font-weight: 500; background: transparent; }
#cardIcon { font-size: 30px; background: transparent; }

#statCardColored {
    border-radius: 12px; border: none; padding: 0;
}
#statCardColored QLabel { color: #FFFFFF; background: transparent; border: none; }

#dashRow { background: #152238; border: 1px solid #1A2744; border-radius: 8px; }

/* ── Tables ── */
QTableWidget {
    background-color: #111B2E; border: 1px solid #1A2744; border-radius: 10px;
    gridline-color: #152238; selection-background-color: rgba(30, 136, 229, 0.18); color: #CBD5E1;
}
QTableWidget::item { padding: 10px 8px; color: #CBD5E1; border: none; background: transparent; }
QTableWidget::item:selected { background-color: rgba(30, 136, 229, 0.2); color: #E2E8F0; }
QTableWidget::item:hover { background-color: rgba(30, 136, 229, 0.08); }

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0D1525, stop:1 #1A2744);
    color: #90A4C4; font-weight: 700; font-size: 11px;
    padding: 12px 8px; border: none; border-bottom: 2px solid #1E88E5;
    text-transform: uppercase; letter-spacing: 0.8px;
}
QHeaderView { background: transparent; }
QTableWidget QTableCornerButton::section { background: #0D1525; border: none; }

/* ── Inputs ── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QDateEdit {
    background-color: #0A1222; border: 1.5px solid #1A2744; border-radius: 8px;
    padding: 9px 12px; color: #E2E8F0;
    selection-background-color: #1E88E5; selection-color: white; min-height: 36px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QDateEdit:focus { border-color: #1E88E5; background-color: #0D1A30; }
QLineEdit:disabled, QComboBox:disabled { color: #334155; background-color: #080E1A; border-color: #152238; }
QLineEdit::placeholder-text { color: #334155; }

QComboBox {
    padding-right: 52px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 40px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    margin-right: 14px;
}
QComboBox QAbstractItemView {
    background: #111B2E; border: 1px solid #1A2744; border-radius: 8px;
    padding: 4px; selection-background-color: rgba(30, 136, 229, 0.25); color: #E2E8F0; outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 10px;
    border-radius: 6px;
}
QComboBox QAbstractItemView::item:hover {
    background: #DBEAFE;
    color: #0F172A;
}
QComboBox QAbstractItemView::item:selected {
    background: #93C5FD;
    color: #0F172A;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { background: #1A2744; border: none; width: 22px; }

QDateEdit::drop-down { border: none; width: 28px; background: transparent; }
QCalendarWidget { background: #111B2E; color: #E2E8F0; border: 1px solid #1A2744; }
QCalendarWidget QToolButton { color: #E2E8F0; background: transparent; }
QCalendarWidget QAbstractItemView { background: #111B2E; color: #E2E8F0; selection-background-color: #1E88E5; selection-color: white; }

/* ── Buttons ── */
QPushButton {
    background-color: #1E88E5; color: #FFFFFF; border: none; border-radius: 8px;
    padding: 10px 22px; font-weight: 700; font-size: 13px; min-height: 36px;
}
QPushButton:hover { background-color: #2196F3; }
QPushButton:pressed { background-color: #1565C0; }
QPushButton:disabled { background-color: #1A2744; color: #334155; }

QPushButton#btnDanger, QPushButton[cssClass="btnDanger"] { background-color: #E91E63; color: white; }
QPushButton#btnDanger:hover, QPushButton[cssClass="btnDanger"]:hover { background-color: #F44336; }
QPushButton#btnSuccess, QPushButton[cssClass="btnSuccess"] { background-color: #4CAF50; color: white; }
QPushButton#btnSuccess:hover, QPushButton[cssClass="btnSuccess"]:hover { background-color: #66BB6A; }
QPushButton#btnWarning, QPushButton[cssClass="btnWarning"] { background-color: #FFC107; color: #0B1121; font-weight: 700; }
QPushButton#btnWarning:hover, QPushButton[cssClass="btnWarning"]:hover { background-color: #FFD54F; }

QPushButton#btnSecondary, QPushButton[cssClass="btnSecondary"] {
    background-color: transparent; border: 1.5px solid #1A2744; color: #64748B; font-weight: 600;
}
QPushButton#btnSecondary:hover, QPushButton[cssClass="btnSecondary"]:hover { border-color: #1E88E5; color: #CBD5E1; background: rgba(30, 136, 229, 0.08); }

QPushButton#btnIcon {
    background: transparent; border: none; padding: 5px; border-radius: 6px;
    font-size: 16px; color: #475569;
    min-width: 32px; max-width: 32px; min-height: 34px; max-height: 32px;
}
QPushButton#btnIcon:hover { background: rgba(30, 136, 229, 0.12); color: #1E88E5; }

/* ── Scrollbar ── */
QScrollBar:vertical { background: transparent; width: 6px; border-radius: 3px; margin: 0; }
QScrollBar::handle:vertical { background: #1A2744; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #1E88E5; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 6px; border-radius: 3px; }
QScrollBar::handle:horizontal { background: #1A2744; border-radius: 3px; }
QScrollBar::handle:horizontal:hover { background: #1E88E5; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Tabs ── */
QTabWidget::pane { background: #111B2E; border: 1px solid #1A2744; border-radius: 10px; top: -1px; }
QTabBar::tab { background: transparent; color: #64748B; padding: 10px 22px; border: none; border-bottom: 2px solid transparent; font-weight: 500; font-size: 13px; }
QTabBar::tab:selected { color: #1E88E5; border-bottom-color: #1E88E5; font-weight: 700; }
QTabBar::tab:hover:!selected { color: #CBD5E1; background: rgba(30, 136, 229, 0.06); }

/* ── Scroll areas ── */
QAbstractScrollArea { background-color: #0B1121; border: none; }

/* ── Dialogs ── */
QDialog > QWidget { background-color: #0B1121; }
#dialogFooter { background-color: #111B2E; border-top: 1px solid #1A2744; }

QFormLayout QLabel, QDialog QLabel { background: transparent; border: none; color: #94A3B8; font-size: 12px; font-weight: 600; }

QMessageBox, QMessageBox QWidget { background: #111B2E; color: #E2E8F0; }
QMessageBox QLabel { color: #E2E8F0; background: transparent; }
QMessageBox QPushButton {
    min-width: 96px;
    min-height: 36px;
    padding: 8px 16px;
    background: #2196F3;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
}
QMessageBox QPushButton:hover { background: #1E88E5; }
QMessageBox QPushButton:pressed { background: #1565C0; }

/* ── Separators ── */
QFrame#separator, QFrame[cssClass="separator"] { background: #1A2744; max-height: 1px; border: none; }

/* ── Search bar ── */
QLineEdit#searchBar { background: #0A1222; border: 1.5px solid #1A2744; border-radius: 24px; padding: 10px 16px; font-size: 14px; color: #E2E8F0; }
QLineEdit#searchBar:focus { border-color: #1E88E5; background: #0D1A30; }

/* ── POS Cart panel ── */
#cartPanel { background: #0D1525; border-left: 1px solid #1A2744; min-width: 360px; max-width: 520px; }
#cartHeader { background: #0A1222; border-bottom: 1px solid #1A2744; }
#cartTotalPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1565C0, stop:1 #0D47A1);
    border-radius: 14px; margin: 10px; padding: 16px; border: none;
}
#cartTotalPanel QLabel { background: transparent; border: none; padding: 0; color: white; }
#cartTotalLabel { font-size: 26px; font-weight: 700; color: white; background: transparent; border: none; padding: 0; }
#cartSubtotalLabel { font-size: 12px; color: rgba(255, 255, 255, 0.78); background: transparent; border: none; padding: 0; }

/* ── Badges ── */
QLabel#badge { background-color: #E91E63; color: white; border-radius: 10px; padding: 2px 8px; font-size: 11px; font-weight: 700; border: none; }
QLabel#badgeSuccess { background-color: #4CAF50; color: white; border-radius: 10px; padding: 2px 8px; font-size: 11px; font-weight: 600; border: none; }
QLabel#badgeWarning { background-color: #FFC107; color: #0B1121; border-radius: 10px; padding: 2px 8px; font-size: 11px; font-weight: 700; border: none; }
QLabel#badgeInfo { background-color: #1E88E5; color: white; border-radius: 10px; padding: 2px 8px; font-size: 11px; border: none; }

/* ── Alerts ── */
#alertLow { background: rgba(233, 30, 99, 0.12); border: 1px solid rgba(233, 30, 99, 0.4); border-radius: 8px; padding: 10px 14px; }
#alertWarning { background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.4); border-radius: 8px; padding: 10px 14px; }

/* ── Tooltips ── */
QToolTip { background: #1A2744; color: #E2E8F0; border: 1px solid #2C5282; border-radius: 6px; padding: 6px 10px; font-size: 12px; }

/* ── CheckBox / RadioButton ── */
QCheckBox, QRadioButton { color: #CBD5E1; spacing: 8px; font-size: 13px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; border: 2px solid #2C5282; border-radius: 4px; background: #0A1222; }
QCheckBox::indicator:checked { background: #1E88E5; border-color: #1E88E5; }
QRadioButton::indicator { border-radius: 9px; }
QRadioButton::indicator:checked { background: #1E88E5; border-color: #1E88E5; }

/* ── GroupBox ── */
QGroupBox { border: 1.5px solid #1A2744; border-radius: 10px; margin-top: 16px; padding-top: 16px; color: #475569; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; background: transparent; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 8px; left: 12px; color: #1E88E5; background: transparent; }

/* ── ProgressBar ── */
QProgressBar { background: #1A2744; border-radius: 6px; border: none; height: 8px; color: transparent; text-align: center; }
QProgressBar::chunk { background: #1E88E5; border-radius: 6px; }

/* ── Frames ── */
QFrame#viewCard { background: #111B2E; border: 1px solid #1A2744; border-radius: 12px; }

/* ── Login ── */
#loginDialog { background: #0B1121; }
#loginForm { background: #111B2E; }

/* ── App close button ── */
QPushButton#btnCloseApp {
    background: #E91E63; color: white; border: none; border-radius: 6px;
    font-size: 14px; font-weight: 700;
    min-width: 36px; max-width: 36px; min-height: 34px; max-height: 34px; padding: 0;
}
QPushButton#btnCloseApp:hover { background: #C2185B; }
QPushButton#btnCloseApp:pressed { background: #AD1457; }



#mainCentralWidget,
#mainStack,
#dashboardContent {
    background: #0B1121;
}

QScrollArea#dashboardScroll,
QScrollArea#dashboardScroll > QWidget,
QScrollArea#dashboardScroll > QWidget > QWidget {
    background: #0B1121;
    border: none;
}

#topNavLinksRow {
    background: transparent;
}

#topNavLinksRow QPushButton#topNavBtn {
    min-height: 36px;
}

#dashboardContent QScrollArea,
#dashboardContent QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

#dashboardContent #statCard,
#dashboardContent #dashRow,
#dashboardContent QGroupBox {
    background: #0D1525;
}
